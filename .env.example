# Local Environment Configuration for Darbar Restaurant
# Copy / update values according to your local setup or cloud services

PORT=5000
VITE_PORT=5173
BASE_PATH=/
API_SERVER_URL=http://localhost:5000
LOG_LEVEL=info

# PostgreSQL Connection String (Replace with your actual PostgreSQL connection string)
DATABASE_URL=postgresql://user:password@localhost:5432/darbar_db

# Clerk Keys
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# Admin Settings
ADMIN_EMAILS=owner@darbar.com
ADMIN_PASSWORD=change_this_admin_password

# Supabase Storage
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
SUPABASE_STORAGE_BUCKET=menu-images

# Resend Email
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=onboarding@resend.dev




# # ============================================================================
# # Darbar Restaurant - Local Environment Configuration
# # ============================================================================

# # ----------------------------------------------------------------------------
# # 1. Server & Application Ports
# # ----------------------------------------------------------------------------
# PORT=5000
# VITE_PORT=5173
# BASE_PATH=/
# API_SERVER_URL=http://localhost:5000
# LOG_LEVEL=info

# # ----------------------------------------------------------------------------
# # 2. PostgreSQL Database Connection String (REQUIRED)
# # ----------------------------------------------------------------------------
# # Connection string format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# # For Supabase Postgres (Cloud): postgresql://postgres.[project-ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
# # For Local Postgres (Windows): postgresql://postgres:password@localhost:5432/darbar_db
# DATABASE_URL=postgresql://user:password@localhost:5432/darbar_db

# # ----------------------------------------------------------------------------
# # 3. Clerk Authentication Keys (Clerk Dashboard -> API Keys)
# # ----------------------------------------------------------------------------
# CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
# VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
# VITE_CLERK_PROXY_URL=

# # ----------------------------------------------------------------------------
# # 4. Admin Access & Authentication
# # ----------------------------------------------------------------------------
# # Comma-separated list of admin email addresses granted admin access
# ADMIN_EMAILS=owner@darbar.com,manager@darbar.com
# # Password for /api/admin/login endpoint
# ADMIN_PASSWORD=change_this_admin_password

# # ----------------------------------------------------------------------------
# # 5. Supabase Storage Configuration (Food Image Uploads)
# # ----------------------------------------------------------------------------
# # Supabase Dashboard -> Project Settings -> API
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# SUPABASE_STORAGE_BUCKET=menu-images

# # ----------------------------------------------------------------------------
# # 6. Resend Email Service Credentials (Resend Dashboard -> API Keys & Domains)
# # ----------------------------------------------------------------------------
# RESEND_API_KEY=re_123456789
# # Use onboarding@resend.dev for testing or your verified domain email
# RESEND_FROM_EMAIL=orders@darbar-restaurant.com
