{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "preinstall": "echo Using pnpm",
    "dev:server": "pnpm --filter @workspace/api-server run dev",
    "dev:web": "pnpm --filter @workspace/darbar-restaurant run dev",
    "dev": "pnpm --parallel --filter @workspace/api-server --filter @workspace/darbar-restaurant run dev",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "devDependencies": {
    "@tailwindcss/oxide": "4.3.0",
    "lightningcss": "1.32.0",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  }
}